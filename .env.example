APP_NAME="White Label Stock API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8005
APP_TIMEZONE=UTC
# Fuso do negócio: decide o "hoje" das regras de validade (vencido, produção, filtros por dia).
# Os timestamps continuam gravados em UTC. Cada instalação white label define o seu.
BUSINESS_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Local: arquivo (storage/logs/laravel.log). Produção: `stderr` (vai para `docker compose logs`).
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Local: debug. Produção: info (ou warning), senão cada consulta lenta e aviso enche o disco/log do Docker.
LOG_LEVEL=debug

# Mostra a mensagem da exceção em `data.message_error` nas respostas 500 (nunca em produção)
SHOW_ERROR_MESSAGE=false

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=white_label_stock
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
# Quantas vezes uma transação de estoque é repetida em deadlock/serialização antes de responder 409
DB_TRANSACTION_ATTEMPTS=3
# Espera máxima por um lock (55P03 → 409) e duração máxima de uma consulta (cancelada → 500). `0` desliga.
DB_LOCK_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=30s
# Porta do Postgres exposta no host (ferramentas de banco e setup do e2e do web)
FORWARD_DB_PORT=5443

# A API é stateless (tokens opacos no header Authorization: Bearer): sessão e fila não são usadas
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Sessão (tokens opacos: access no header Authorization: Bearer, refresh no corpo do refresh)
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Seed — primeira conta de acesso (usada por `make db-seed`)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Proxies confiáveis para X-Forwarded-For (o IP do cliente é a chave do rate limit).
# Padrão: redes privadas (rede Docker do web e do Nginx Proxy Manager). Nunca use `*`.
TRUSTED_PROXIES=PRIVATE_SUBNETS

# Backups (`make backup`, também rodado pelo `make deploy`): quantos dumps manter em backups/ e para
# onde copiar fora deste disco (destino do rsync: outro disco montado ou usuario@host:/caminho/).
BACKUP_KEEP=14
BACKUP_OFFSITE=

# Docker
DOCKER_COMPOSE_FILE=docker-compose.local.yml
# Local — porta da API no host (em produção não há porta publicada)
NGINX_PORT=8005
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
# Produção — rede Docker do Nginx Proxy Manager (o nginx da API entra nela)
PROXY_NETWORK=nginx-proxy-manager
