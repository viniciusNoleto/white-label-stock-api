APP_NAME="White Label Stock API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8005
APP_TIMEZONE=UTC

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Mostra a mensagem da exceção em `data.message_error` nas respostas 500 (nunca em produção)
SHOW_ERROR_MESSAGE=false

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=white_label_stock
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
# Porta do Postgres exposta no host (ferramentas de banco e setup do e2e do web)
FORWARD_DB_PORT=5443

# A API é stateless (tokens opacos em cookies): sessão e fila não são usadas
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Sessão (tokens opacos em cookies httpOnly)
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Cookies só por HTTPS. Vazio = true em produção, false nos demais ambientes.
COOKIE_SECURE=

# Seed — primeira conta de acesso (usada por `make db-seed`)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Docker
DOCKER_COMPOSE_FILE=docker-compose.local.yml
NGINX_PORT=8005
NGINX_SSL_PORT=443
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
CERTBOT_EMAIL_ADDRESS=
CERTBOT_DOMAIN=
